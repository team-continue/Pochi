[Unit]
Description=Pochi web user interface
After=pochi-web-api.service
Wants=pochi-web-api.service

[Service]
Type=simple
WorkingDirectory=/home/continue/Pochi/pochi_hardware/web
Environment=PATH=/home/continue/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/continue/.local/bin/npm run start -- --ip 0.0.0.0 --port 3000
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
