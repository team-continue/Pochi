[Unit]
Description=Pochi Teensy USB to UDP bridge
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/continue/Pochi
ExecStart=/home/continue/.local/bin/uv run python pochi_hardware/src/teensy_udp_bridge.py --serial /dev/ttyACM0 --command-bind 127.0.0.1:15000 --state-dest 127.0.0.1:15001
Restart=always
RestartSec=1

[Install]
WantedBy=default.target

